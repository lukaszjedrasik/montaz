---
import Layout from '../layouts/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';

// Podmień id (fragment z youtube.com/watch?v=TEN_FRAGMENT) i title na własne.
const videos = [
  { id: 'dQw4w9WgXcQ', title: 'Wstaw tytuł filmu 1' },
  { id: 'dQw4w9WgXcQ', title: 'Wstaw tytuł filmu 2' },
  { id: 'dQw4w9WgXcQ', title: 'Wstaw tytuł filmu 3' },
  { id: 'dQw4w9WgXcQ', title: 'Wstaw tytuł filmu 4' },
];

// Osoby, z którymi współpracowałeś — podmień dane i linki social media.
const people = [
  {
    name: 'Wstaw imię i nazwisko',
    role: 'Wstaw rolę / branżę',
    links: [
      { label: 'Instagram', url: 'https://instagram.com/' },
      { label: 'YouTube', url: 'https://youtube.com/' },
    ],
  },
  {
    name: 'Wstaw imię i nazwisko',
    role: 'Wstaw rolę / branżę',
    links: [
      { label: 'Instagram', url: 'https://instagram.com/' },
      { label: 'TikTok', url: 'https://tiktok.com/' },
    ],
  },
  {
    name: 'Wstaw imię i nazwisko',
    role: 'Wstaw rolę / branżę',
    links: [{ label: 'Instagram', url: 'https://instagram.com/' }],
  },
];
---

<Layout
  title="Łukasz Yot — Montażysta filmów do Social Mediów / Content Creator"
  description="Montażysta wideo i content creator."
>
  <header class="site-header">
    <div class="container header-inner">
      <a href="#hero" class="mark mono">Łukasz Yot</a>
      <nav>
        <a href="#o-mnie">O mnie</a>
        <a href="#praca">Realizacje</a>
        <a href="#wspolpraca">Współprace</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </div>
  </header>

  <main>
    <section id="hero" class="section hero">
      <div class="container">
        <p class="mono hero-timecode">00:00:00:00</p>
        <h1 class="hero-headline gradient-text">
          Wstaw swój<br />główny nagłówek.
        </h1>
        <p class="hero-sub">
          Wstaw krótki opis tego, kim jesteś i czym się zajmujesz —
          dwa-trzy zdania wystarczą.
        </p>
        <div class="hero-actions">
          <a href="mailto:kontakt@twojadomena.pl" class="btn btn-primary"
            >Napisz do mnie</a
          >
        </div>
      </div>
    </section>

    <section id="o-mnie" class="section">
      <div class="container">
        <SectionDivider timecode="00:00:14:00" label="O mnie" />
        <h2 class="section-title gradient-text">Wstaw nagłówek sekcji.</h2>
        <div class="prose">
          <p>Wstaw akapit o swoim backgroundzie i doświadczeniu.</p>
          <p>Wstaw akapit o tym, co Cię wyróżnia jako montażystę.</p>
          <p>Wstaw akapit zamykający — dlaczego warto z Tobą pracować.</p>
        </div>
      </div>
    </section>

    <section id="certyfikat" class="section">
      <div class="container">
        <SectionDivider timecode="00:00:38:00" label="Kursy" />
        <h2 class="section-title gradient-text">Wstaw nagłówek sekcji.</h2>
        <div class="cert-card">
          <img
            src="/certyfikat-placeholder.svg"
            alt="Certyfikat ukończenia kursu montażu"
            class="cert-image"
            loading="lazy"
          />
          <div class="cert-content">
            <div>
              <p class="cert-course mono">Kurs Montażu</p>
              <p class="cert-author">Dawid Kowolik — kursmontazu.pl</p>
              <p class="cert-status">Wstaw status ukończenia kursu.</p>
            </div>
            <div class="cert-meta mono">
              <span>UKOŃCZONO</span>
              <span class="cert-date">[uzupełnij datę]</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="praca" class="section">
      <div class="container">
        <SectionDivider timecode="00:01:02:00" label="Realizacje" />
        <h2 class="section-title gradient-text">Wstaw nagłówek sekcji.</h2>
        <div class="prose">
          <p>Wstaw krótki opis tej sekcji.</p>
        </div>
        <div class="video-grid">
          {
            videos.map((video) => (
              <div class="video-card">
                <div class="video-frame">
                  <iframe
                    src={`https://www.youtube.com/embed/${video.id}`}
                    title={video.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
                <p class="video-title mono">{video.title}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="wspolpraca" class="section">
      <div class="container">
        <SectionDivider timecode="00:01:18:00" label="Współprace" />
        <h2 class="section-title gradient-text">Wstaw nagłówek sekcji.</h2>
        <div class="prose">
          <p>Wstaw krótki opis tej sekcji.</p>
        </div>
        <div class="people-grid">
          {
            people.map((person) => (
              <div class="person-card">
                <div class="person-avatar">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="8.5" r="3.5" stroke="#9c9384" stroke-width="1.3" />
                    <path
                      d="M4.5 20c1.2-3.8 4.3-6 7.5-6s6.3 2.2 7.5 6"
                      stroke="#9c9384"
                      stroke-width="1.3"
                      stroke-linecap="round"
                    />
                  </svg>
                </div>
                <p class="person-name">{person.name}</p>
                <p class="person-role mono">{person.role}</p>
                <div class="person-links">
                  {person.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="kontakt" class="section kontakt-section">
      <div class="container">
        <SectionDivider timecode="00:01:34:00" label="Kontakt" />
        <h2 class="section-title gradient-text">Wstaw nagłówek sekcji.</h2>
        <p class="prose kontakt-sub">
          Wstaw krótki opis, jak się z Tobą skontaktować i czego się
          spodziewać.
        </p>
        <div class="hero-actions">
          <a href="mailto:kontakt@twojadomena.pl" class="btn btn-primary gradient-text"
            >Napisz do mnie</a
          >
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="mono">Łukasz Yot © {new Date().getFullYear()}</span>
      <span class="mono">montaż wideo º social media º content creator</span>
    </div>
  </footer>
</Layout>

<style>
  .site-header {
    padding-block: 1.5rem;
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mark {
    font-size: var(--text-sm);
    text-decoration: none;
    font-weight: 500;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }

  nav a {
    text-decoration: none;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: var(--ink);
  }

  .hero {
    padding-top: clamp(3rem, 8vw, 6rem);
  }

  .hero-timecode {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: 1.5rem;
  }

  .hero-headline {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .hero-sub {
    margin-top: 1.75rem;
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: 42ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .section-title {
    font-size: var(--text-2xl);
    max-width: 16ch;
    margin-bottom: 2rem;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    color: var(--ink-soft);
    font-size: var(--text-base);
  }

  .prose p {
    max-width: var(--measure);
  }

  .cert-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-image: var(--gradient) 1;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    max-width: 40rem;
  }

  .cert-image {
    width: 140px;
    height: 100px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--line);
  }

  .cert-content {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    min-width: 200px;
  }

  .cert-course {
    font-size: var(--text-lg);
    margin-bottom: 0.35rem;
  }

  .cert-author {
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }

  .cert-status {
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .cert-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    flex-shrink: 0;
  }

  .cert-date {
    color: var(--ink-soft);
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-block: 2.5rem;
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-title {
    margin-top: 0.6rem;
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  #praca .btn {
    margin-top: 0.5rem;
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .person-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .person-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .person-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
  }

  .person-role {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .person-links a {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .person-links a:hover {
    color: var(--ink);
  }

  .kontakt-section {
    border-top: 1px solid var(--line);
  }

  .kontakt-sub {
    margin-top: -0.75rem;
    margin-bottom: 2rem;
    color: var(--ink-soft);
  }

  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    nav {
      gap: 1rem;
    }
    nav a {
      font-size: var(--text-xs);
    }
    .cert-card {
      align-items: flex-start;
      flex-direction: column;
    }
    .cert-image {
      width: 100%;
      height: 160px;
    }
    .cert-meta {
      align-items: flex-start;
    }
  }
</style>
