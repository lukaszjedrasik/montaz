---
import Layout from '../layouts/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { ui, type Lang } from '../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'pl' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
  ];
}

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];

const videos = [
  { id: '7ioxndcRB9c', title: 'Radek Haberko - zgadnij dziewczyne' },
  { id: 'apyzux0NUds', title: 'Radek Haberko - lepsza niż tata' },
  { id: 'JR9UqcWzA1M', title: 'Akademia Piękna - jaki zabieg na jaki problem' },
  { id: 'ZKAaKkM8Pw0', title: 'Akademia Piękna - 3 kwasy' },
  { id: 'YeDepd26IGQ', title: 'Akademia Piękna - unboxing Clarena' },
  { id: 'V6US74MIAKM', title: 'Crators Weekend - event' },
  { id: '1SjGz7fn7OU', title: 'Konopksyy - Khaby Lame' },
  { id: 'CsQ24Mc_ipM', title: 'Przemek Pro - Vlog Prawdy' },
];

// const people = [
//   {
//     name: 'Wstaw imię i nazwisko',
//     role: { pl: 'Wstaw rolę / branżę', en: 'Role / industry' },
