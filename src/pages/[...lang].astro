---

<Layout title={t.metaTitle} description={t.metaDesc} lang={lang}>
  <header class="site-header">
    <div class="container header-inner">
      <a href="#hero" class="mark mono">Łukasz Yot</a>
      <nav>
        <a href={`#${t.ids.about}`}>{t.nav.about}</a>
        <a href={`#${t.ids.work}`}>{t.nav.work}</a>
        <!--<a href={`#${t.ids.collab}`}>{t.nav.collab}</a>-->
        <a href={`#${t.ids.contact}`}>{t.nav.contact}</a>
        <div class="lang-switch mono" role="group" aria-label="Language">
          <a href="/" hreflang="pl" lang="pl" aria-current={lang === 'pl' ? 'true' : undefined}>PL</a>
          <span aria-hidden="true">/</span>
          <a href="/en/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <section id="hero" class="section hero">
      <div class="container">
        <p class="mono hero-timecode">00:00:00:00</p>
        <h1 class="hero-headline gradient-text">{t.hero.title}</h1>
        <p class="hero-sub">{t.hero.sub}</p>
        <div class="hero-actions">
          <a href="mailto:gulasz.yt@gmail.com" class="btn btn-primary">{t.hero.cta}</a>
        </div>
      </div>
    </section>

    <section id={t.ids.about} class="section">
      <div class="container">
        <SectionDivider timecode="00:00:14:00" label={t.about.label} />
        <h2 class="section-title gradient-text">{t.about.title}</h2>
        <div class="prose">
          <p>{t.about.p1}</p>
          <p>{t.about.listIntro}</p>
          <div class="skill-grid">
            {
              t.about.items.map((item) => (
                  <div class="skill-card">
                    <p class="skill-title">{item.title}</p>
                    <p class="skill-text">{item.text}</p>
                  </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id={t.ids.work} class="section">
      <div class="container">
        <SectionDivider timecode="00:01:02:00" label={t.work.label} />
        <h2 class="section-title gradient-text">{t.work.title}</h2>
        <div class="prose">
          <p>{t.work.intro}</p>
        </div>
        <div class="video-grid">
          {
            videos.map((video) => (
              <div class="video-card">
                <div class="video-frame">
                  <iframe
                    src={`https://www.youtube.com/embed/${video.id}`}
                    title={video.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
                <p class="video-title mono">{video.title}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!--<section id={t.ids.collab} class="section">-->
    <!--  <div class="container">-->
    <!--    <SectionDivider timecode="00:01:18:00" label={t.collab.label} />-->
    <!--    <h2 class="section-title gradient-text">{t.collab.title}</h2>-->
    <!--    <div class="prose">-->
    <!--      <p>{t.collab.intro}</p>-->
    <!--    </div>-->
    <!--    <div class="people-grid">-->
    <!--      {-->
    <!--        people.map((person) => (-->
    <!--            <div class="person-card">-->
    <!--              <div class="person-avatar">-->
    <!--                <svg width="28" height="28" viewBox="0 0 24 24" fill="none">-->
    <!--                  <circle cx="12" cy="8.5" r="3.5" stroke="#9c9384" stroke-width="1.3" />-->
    <!--                  <path-->
    <!--                      d="M4.5 20c1.2-3.8 4.3-6 7.5-6s6.3 2.2 7.5 6"-->
    <!--                      stroke="#9c9384"-->
    <!--                      stroke-width="1.3"-->
    <!--                      stroke-linecap="round"-->
    <!--                  />-->
    <!--                </svg>-->
    <!--              </div>-->
    <!--              <p class="person-name">{person.name}</p>-->
    <!--              <p class="person-role mono">{person.role[lang]}</p>-->
    <!--              <div class="person-links">-->
    <!--                {person.links.map((link) => (-->
    <!--                    <a href={link.url} target="_blank" rel="noopener noreferrer">-->
    <!--                      {link.label}-->
    <!--                    </a>-->
    <!--                ))}-->
    <!--              </div>-->
    <!--            </div>-->
    <!--        ))-->
    <!--      }-->
    <!--    </div>-->
    <!--  </div>-->
    <!--</section>-->

    <section id={t.ids.courses} class="section">
      <div class="container">
        <SectionDivider timecode="00:00:38:00" label={t.courses.label} />
        <h2 class="section-title gradient-text">{t.courses.title}</h2>
        <div class="cert-card">
          <img src="/certyfikat.png" alt={t.courses.certAlt} class="cert-image" loading="lazy" />
          <div class="cert-content">
            <div>
              <p class="cert-course mono">{t.courses.name}</p>
              <a href="https://kursmontazu.pl/" target="_blank" class="cert-author">
                Dawid Kowolik — kursmontazu.pl
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id={t.ids.contact} class="section">
      <div class="container">
        <SectionDivider timecode="00:01:34:00" label={t.contact.label} />
        <h2 class="section-title gradient-text">{t.contact.title}</h2>
        <p class="prose kontakt-sub">{t.contact.sub}</p>
        <div class="hero-actions">
          <a href="mailto:gulasz.yt@gmail.com" class="btn btn-primary gradient-text"
            >{t.contact.cta}</a
          >
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="mono">Łukasz Yot © {new Date().getFullYear()}</span>
      <span class="mono">{t.footer}</span>
    </div>
  </footer>
</Layout>

<style>
  nav .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-left: clamp(1rem, 3vw, 2rem);
    border-left: 1px solid var(--line);
    color: var(--ink-faint);
    font-size: var(--text-xs);
  }

  nav .lang-switch a {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }

  nav .lang-switch a:hover {
    color: var(--ink);
  }

  nav .lang-switch a[aria-current='true'] {
    color: var(--ink);
    font-weight: 500;
    pointer-events: none;
  }
  .site-header {
    padding-block: 1.5rem;
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mark {
    font-size: var(--text-sm);
    text-decoration: none;
    font-weight: 500;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }

  nav a {
    text-decoration: none;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: var(--ink);
  }

  .hero {
    padding-top: clamp(3rem, 8vw, 3rem);
  }

  .hero-timecode {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: 1.5rem;
  }

  .hero-headline {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .hero-sub {
    margin-top: 1.75rem;
    font-size: var(--text-lg);
    color: var(--ink-soft);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .section-title {
    font-size: var(--text-2xl);
    max-width: 100%;
    margin-bottom: 2rem;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    color: var(--ink-soft);
    font-size: var(--text-base);
  }

  .cert-card {
    border: 1px solid transparent;
    border-radius: 12px;
    background:
        linear-gradient(var(--surface), var(--surface)) padding-box,
        var(--gradient) border-box;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .cert-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--line);
  }

  .cert-content {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    min-width: 200px;
  }

  .cert-course {
    font-size: var(--text-lg);
    margin-bottom: 0.35rem;
  }

  .cert-author {
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
    text-decoration: none;
  }

  .cert-status {
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .cert-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    flex-shrink: 0;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-block: 2.5rem;
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-title {
    margin-top: 0.6rem;
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .person-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .person-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .person-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
  }

  .person-role {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .person-links a {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .person-links a:hover {
    color: var(--ink);
  }

  .kontakt-sub {
    margin-top: -0.75rem;
    margin-bottom: 2rem;
    color: var(--ink-soft);
  }

  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    nav {
      gap: 1rem;
    }
    nav a {
      font-size: var(--text-xs);
    }
    .cert-card {
      align-items: flex-start;
      flex-direction: column;
    }
    .cert-image {
      width: 100%;
      height: 100%;
    }
    .cert-meta {
      align-items: flex-start;
    }
  }

  .skill-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(6, 1fr);
    margin-top: 1.25rem;
  }

  .skill-card {
    grid-column: span 2;
    padding: 1.25rem;
    border: 1px solid transparent;
    border-radius: 12px;
    background:
        linear-gradient(var(--surface), var(--surface)) padding-box,
        var(--gradient) border-box;
    transition: border-color 0.15s ease;
  }

  .skill-title {
    font-weight: 600;
    color: var(--ink);
  }

  .skill-text {
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  @media (max-width: 56rem) {
    .skill-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .skill-card,
    .skill-card:nth-child(n + 4) {
      grid-column: auto;
    }
    .skill-card:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .skill-grid {
      grid-template-columns: 1fr;
    }
    .skill-card:last-child {
      grid-column: auto;
    }
  }
</style>
