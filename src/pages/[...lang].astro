---
import Layout from '../layouts/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { ui, type Lang } from '../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'pl' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
  ];
}

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];

type Video = { id: string; title: string; client: string; format: 'v' | 'h' };

const videos: Video[] = [
  { id: '-kNaBL213Bg', title: 'The Da Silva Team - Penn Station Walk What Is Brick142', client: 'The Da Silva Team', format: 'v' },
  { id: '1UKcqoH_DqU', title: 'The Da Silva Team - Chester Team Story part 1', client: 'The Da Silva Team', format: 'v' },
  { id: 'zB0XG7CAqos', title: 'The Da Silva Team - Chester Team Story part 2', client: 'The Da Silva Team', format: 'v' },
  { id: '6da5Cz3H4J0', title: 'The Da Silva Team - Merch Jacket Left In Office', client: 'The Da Silva Team', format: 'v' },
  { id: 'CMjYVNfzfXY', title: 'How to memorize the script?', client: 'Inne', format: 'v' },
  { id: '7ioxndcRB9c', title: 'Radek Haberko - zgadnij dziewczyne', client: 'Radek Haberko', format: 'v' },
  { id: 'apyzux0NUds', title: 'Radek Haberko - lepsza niż tata', client: 'Radek Haberko', format: 'v' },
  { id: 'JR9UqcWzA1M', title: 'Akademia Piękna - jaki zabieg na jaki problem', client: 'Akademia Piękna', format: 'v' },
  { id: 'ZKAaKkM8Pw0', title: 'Akademia Piękna - 3 kwasy', client: 'Akademia Piękna', format: 'v' },
  { id: 'YeDepd26IGQ', title: 'Akademia Piękna - unboxing Clarena', client: 'Akademia Piękna', format: 'v' },
  { id: 'V6US74MIAKM', title: 'Creators Weekend - event', client: 'Creators Weekend', format: 'v' },
  { id: '1SjGz7fn7OU', title: 'Konopksyy - Khaby Lame', client: 'Konopksyy', format: 'h' },
  { id: 'CsQ24Mc_ipM', title: 'Przemek Pro - Vlog Prawdy', client: 'Przemek Pro', format: 'h' },
];

const OTHER = '__other';
const clientCount = new Map<string, number>();
videos.forEach((v) => clientCount.set(v.client, (clientCount.get(v.client) ?? 0) + 1));
const groupOf = (v: Video) => ((clientCount.get(v.client) ?? 0) >= 2 ? v.client : OTHER);
const clients = [...new Set(videos.map(groupOf))].sort((a, b) => (a === OTHER ? 1 : b === OTHER ? -1 : 0));
const INITIAL_VISIBLE = 6;

// const people = [
//   {
//     name: 'Wstaw imię i nazwisko',
//     role: { pl: 'Wstaw rolę / branżę', en: 'Role / industry' },
//     links: [
//       { label: 'Instagram', url: 'https://instagram.com/' },
//       { label: 'YouTube', url: 'https://youtube.com/' },
//     ],
//   },
// ];
---

<Layout title={t.metaTitle} description={t.metaDesc} lang={lang}>
  <header class="site-header">
    <div class="container header-inner">
      <a href="#hero" class="mark mono">Łukasz Yot</a>
      <nav>
        <a href={`#${t.ids.about}`}>{t.nav.about}</a>
        <a href={`#${t.ids.work}`}>{t.nav.work}</a>
        <!--<a href={`#${t.ids.collab}`}>{t.nav.collab}</a>-->
        <a href={`#${t.ids.contact}`}>{t.nav.contact}</a>
        <div class="lang-switch mono" role="group" aria-label="Language">
          <a href="/" hreflang="pl" lang="pl" aria-current={lang === 'pl' ? 'true' : undefined}>PL</a>
          <span aria-hidden="true">/</span>
          <a href="/en/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <div class="theme-switch" role="group" aria-label={t.theme.label}>
          <button type="button" data-theme-set="light" aria-label={t.theme.light} title={t.theme.light}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
          <span aria-hidden="true">/</span>
          <button type="button" data-theme-set="dark" aria-label={t.theme.dark} title={t.theme.dark}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            </svg>
          </button>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <section id="hero" class="section hero">
      <div class="container">
        <p class="mono hero-timecode">00:00:00:00</p>
        <h1 class="hero-headline gradient-text">{t.hero.title}</h1>
        <p class="hero-sub">{t.hero.sub}</p>
        <div class="hero-actions">
          <a href="mailto:gulasz.yt@gmail.com" class="btn btn-primary">{t.hero.cta}</a>
        </div>
      </div>
    </section>

    <section id={t.ids.about} class="section">
      <div class="container">
        <SectionDivider timecode="00:00:14:00" label={t.about.label} />
        <h2 class="section-title gradient-text">{t.about.title}</h2>
        <div class="prose">
          <p>{t.about.p1}</p>
          <p>{t.about.listIntro}</p>
          <div class="skill-grid">
            {
              t.about.items.map((item) => (
                  <div class="skill-card">
                    <p class="skill-title">{item.title}</p>
                    <p class="skill-text">{item.text}</p>
                  </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id={t.ids.work} class="section">
      <div class="container">
        <SectionDivider timecode="00:01:02:00" label={t.work.label} />
        <h2 class="section-title gradient-text">{t.work.title}</h2>
        <div class="prose">
          <p>{t.work.intro}</p>
        </div>
        <div class="filters" data-filters>
          <div class="filter-row" role="group" aria-label={t.work.filters.format}>
            <span class="filter-label mono">{t.work.filters.format}</span>
            <button type="button" class="chip" data-format="" aria-pressed="true">{t.work.filters.all}</button>
            <button type="button" class="chip" data-format="v" aria-pressed="false">{t.work.filters.vertical}</button>
            <button type="button" class="chip" data-format="h" aria-pressed="false">{t.work.filters.horizontal}</button>
          </div>
          {
            clients.length > 2 && (
              <div class="filter-row" role="group" aria-label={t.work.filters.client}>
                <span class="filter-label mono">{t.work.filters.client}</span>
                <button type="button" class="chip" data-client="" aria-pressed="true">{t.work.filters.all}</button>
                {clients.map((c) => (
                  <button type="button" class="chip" data-client={c} aria-pressed="false">
                    {c === OTHER ? t.work.filters.other : c}
                  </button>
                ))}
              </div>
            )
          }
          <p class="filter-count mono" data-count aria-live="polite"></p>
        </div>

        <div class="video-grid" data-grid data-initial={INITIAL_VISIBLE}>
          {
            videos.map((video) => (
              <a
                class={`video-card ${video.format === 'v' ? 'is-vertical' : 'is-horizontal'}`}
                href={`https://www.youtube.com/watch?v=${video.id}`}
                data-id={video.id}
                data-format={video.format}
                data-client={groupOf(video)}
                data-title={video.title}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="video-thumb">
                  <img
                    src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="video-badge mono">{video.format === 'v' ? '9:16' : '16:9'}</span>
                  <span class="video-play" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                </span>
                <span class="video-title mono">{video.title}</span>
              </a>
            ))
          }
        </div>
        <div class="more-wrap">
          <button type="button" class="btn btn-ghost" data-more hidden>{t.work.more}</button>
        </div>

        <dialog class="video-dialog" data-dialog aria-label="Video">
          <button type="button" class="dialog-close mono" data-close aria-label={t.work.close}>✕</button>
          <div class="dialog-frame" data-frame tabindex="-1" autofocus></div>
        </dialog>
      </div>
    </section>

    <!--<section id={t.ids.collab} class="section">-->
    <!--  <div class="container">-->
    <!--    <SectionDivider timecode="00:01:18:00" label={t.collab.label} />-->
    <!--    <h2 class="section-title gradient-text">{t.collab.title}</h2>-->
    <!--    <div class="prose">-->
    <!--      <p>{t.collab.intro}</p>-->
    <!--    </div>-->
    <!--    <div class="people-grid">-->
    <!--      {-->
    <!--        people.map((person) => (-->
    <!--            <div class="person-card">-->
    <!--              <div class="person-avatar">-->
    <!--                <svg width="28" height="28" viewBox="0 0 24 24" fill="none">-->
    <!--                  <circle cx="12" cy="8.5" r="3.5" stroke="#9c9384" stroke-width="1.3" />-->
    <!--                  <path-->
    <!--                      d="M4.5 20c1.2-3.8 4.3-6 7.5-6s6.3 2.2 7.5 6"-->
    <!--                      stroke="#9c9384"-->
    <!--                      stroke-width="1.3"-->
    <!--                      stroke-linecap="round"-->
    <!--                  />-->
    <!--                </svg>-->
    <!--              </div>-->
    <!--              <p class="person-name">{person.name}</p>-->
    <!--              <p class="person-role mono">{person.role[lang]}</p>-->
    <!--              <div class="person-links">-->
    <!--                {person.links.map((link) => (-->
    <!--                    <a href={link.url} target="_blank" rel="noopener noreferrer">-->
    <!--                      {link.label}-->
    <!--                    </a>-->
    <!--                ))}-->
    <!--              </div>-->
    <!--            </div>-->
    <!--        ))-->
    <!--      }-->
    <!--    </div>-->
    <!--  </div>-->
    <!--</section>-->

    <section id={t.ids.courses} class="section">
      <div class="container">
        <SectionDivider timecode="00:00:38:00" label={t.courses.label} />
        <h2 class="section-title gradient-text">{t.courses.title}</h2>
        <div class="cert-card">
          <img src="/certyfikat.png" alt={t.courses.certAlt} class="cert-image" loading="lazy" />
          <div class="cert-content">
            <div>
              <p class="cert-course mono">{t.courses.name}</p>
              <a href="https://kursmontazu.pl/" target="_blank" class="cert-author">
                Dawid Kowolik — kursmontazu.pl
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id={t.ids.contact} class="section">
      <div class="container">
        <SectionDivider timecode="00:01:34:00" label={t.contact.label} />
        <h2 class="section-title gradient-text">{t.contact.title}</h2>
        <p class="prose kontakt-sub">{t.contact.sub}</p>
        <div class="hero-actions">
          <a href="mailto:gulasz.yt@gmail.com" class="btn btn-primary gradient-text"
            >{t.contact.cta}</a
          >
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="mono">Łukasz Yot © {new Date().getFullYear()}</span>
      <span class="mono">{t.footer}</span>
    </div>
  </footer>
</Layout>

<style>
  nav .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-left: clamp(1rem, 3vw, 2rem);
    border-left: 1px solid var(--line);
    color: var(--ink-faint);
    font-size: var(--text-xs);
  }

  nav .lang-switch a {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }

  nav .lang-switch a:hover {
    color: var(--ink);
  }

  nav .lang-switch a[aria-current='true'] {
    color: var(--ink);
    font-weight: 500;
    pointer-events: none;
  }
  nav .theme-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-left: clamp(1rem, 3vw, 2rem);
    border-left: 1px solid var(--line);
    color: var(--ink-faint);
  }

  .theme-switch button {
    display: inline-grid;
    place-items: center;
    padding: 0.2rem;
    border: 0;
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .theme-switch button:hover {
    color: var(--ink);
  }

  .theme-switch button[aria-pressed='true'] {
    color: var(--ink);
  }

  .site-header {
    padding-block: 1.5rem;
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mark {
    font-size: var(--text-sm);
    text-decoration: none;
    font-weight: 500;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }

  nav a {
    text-decoration: none;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: var(--ink);
  }

  .hero {
    padding-top: clamp(3rem, 8vw, 3rem);
  }

  .hero-timecode {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: 1.5rem;
  }

  .hero-headline {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .hero-sub {
    margin-top: 1.75rem;
    font-size: var(--text-lg);
    color: var(--ink-soft);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .section-title {
    font-size: var(--text-2xl);
    max-width: 100%;
    margin-bottom: 2rem;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    color: var(--ink-soft);
    font-size: var(--text-base);
  }

  .cert-card {
    border: 1px solid transparent;
    border-radius: 12px;
    background:
        linear-gradient(var(--surface), var(--surface)) padding-box,
        var(--gradient) border-box;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .cert-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--line);
  }

  .cert-content {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    min-width: 200px;
  }

  .cert-course {
    font-size: var(--text-lg);
    margin-bottom: 0.35rem;
  }

  .cert-author {
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
    text-decoration: none;
  }

  .cert-status {
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .cert-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    flex-shrink: 0;
  }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-label {
    min-width: 4.5rem;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .chip {
    font: inherit;
    font-size: var(--text-xs);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .chip:hover {
    border-color: var(--ink-faint);
    color: var(--ink);
  }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .filter-count {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .video-grid {
    --thumb-h: 220px;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 1.25rem;
    margin-block: 1.5rem 2rem;
  }

  .video-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    width: fit-content;
    max-width: 100%;
  }

  .video-card[hidden] {
    display: none;
  }

  .video-thumb {
    position: relative;
    display: block;
    height: var(--thumb-h);
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .is-horizontal .video-thumb {
    aspect-ratio: 16 / 9;
  }

  .is-vertical .video-thumb {
    aspect-ratio: 9 / 16;
  }

  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .video-card:hover .video-thumb,
  .video-card:focus-visible .video-thumb {
    border-color: var(--accent-2);
  }

  .video-card:hover .video-thumb img {
    transform: scale(1.03);
  }

  .video-badge {
    position: absolute;
    left: 0.5rem;
    top: 0.5rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.7rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    color: var(--ink-soft);
    backdrop-filter: blur(4px);
  }

  .video-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--gradient);
    color: #fff;
    opacity: 0.92;
    transition: transform 0.15s ease;
  }

  .video-card:hover .video-play {
    transform: scale(1.08);
  }

  .video-title {
    width: 0;
    min-width: 100%;
    font-size: var(--text-xs);
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .more-wrap {
    display: flex;
    justify-content: center;
  }

  .video-dialog {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    overflow: visible;
  }

  .video-dialog::backdrop {
    background: rgba(10, 8, 6, 0.85);
  }

  .dialog-frame {
    --h: min(80vh, 760px);
    height: var(--h);
    max-width: 94vw;
    background: #000;
    border-radius: 10px;
    overflow: hidden;
  }

  .dialog-frame.is-horizontal {
    aspect-ratio: 16 / 9;
    height: auto;
    width: min(94vw, calc(var(--h) * 16 / 9));
  }

  .dialog-frame.is-vertical {
    aspect-ratio: 9 / 16;
    width: calc(var(--h) * 9 / 16);
    max-width: 94vw;
    height: auto;
    max-height: var(--h);
  }

  .dialog-frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .dialog-close {
    position: absolute;
    right: 0.6rem;
    top: 0.6rem;
    z-index: 2;
    width: 2.2rem;
    height: 2.2rem;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .dialog-frame {
    outline: none;
  }

  [data-more][hidden] {
    display: none !important;
  }

  .chip:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    border-style: dashed;
  }

  .chip:disabled:hover {
    border-color: var(--line);
    color: var(--ink-soft);
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .person-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .person-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .person-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
  }

  .person-role {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .person-links a {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .person-links a:hover {
    color: var(--ink);
  }

  .kontakt-sub {
    margin-top: -0.75rem;
    margin-bottom: 2rem;
    color: var(--ink-soft);
  }

  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .video-grid {
      --thumb-h: 190px;
      gap: 1.25rem 0.75rem;
    }
    .filter-label {
      flex-basis: 100%;
    }
    .header-inner {
      flex-wrap: wrap;
      row-gap: 0.75rem;
    }
    nav {
      gap: 1rem;
    }
    nav a {
      font-size: var(--text-xs);
    }
    .cert-card {
      align-items: flex-start;
      flex-direction: column;
    }
    .cert-image {
      width: 100%;
      height: 100%;
    }
    .cert-meta {
      align-items: flex-start;
    }
  }

  .skill-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(6, 1fr);
    margin-top: 1.25rem;
  }

  .skill-card {
    grid-column: span 2;
    padding: 1.25rem;
    border: 1px solid transparent;
    border-radius: 12px;
    background:
        linear-gradient(var(--surface), var(--surface)) padding-box,
        var(--gradient) border-box;
    transition: border-color 0.15s ease;
  }

  .skill-title {
    font-weight: 600;
    color: var(--ink);
  }

  .skill-text {
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  @media (max-width: 56rem) {
    .skill-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .skill-card,
    .skill-card:nth-child(n + 4) {
      grid-column: auto;
    }
    .skill-card:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .skill-grid {
      grid-template-columns: 1fr;
    }
    .skill-card:last-child {
      grid-column: auto;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  if (grid) {
    const cards = [...grid.querySelectorAll<HTMLAnchorElement>('.video-card')];
    const moreBtn = document.querySelector<HTMLButtonElement>('[data-more]')!;
    const countEl = document.querySelector<HTMLElement>('[data-count]')!;
    const filters = document.querySelector<HTMLElement>('[data-filters]')!;
    const initial = Number(grid.dataset.initial) || 6;
    const ofWord = document.documentElement.lang === 'en' ? 'of' : 'z';
    let format = '';
    let client = '';
    let limit = initial;

    const chips = [...filters.querySelectorAll<HTMLButtonElement>('.chip')];
    const fits = (c: HTMLElement, f: string, cl: string) =>
      (!f || c.dataset.format === f) && (!cl || c.dataset.client === cl);

    const render = () => {
      const matching = cards.filter((c) => fits(c, format, client));
      chips.forEach((chip) => {
        const isFormat = 'format' in chip.dataset;
        const n = cards.filter((c) =>
          isFormat ? fits(c, chip.dataset.format ?? '', client) : fits(c, format, chip.dataset.client ?? '')
        ).length;
        chip.disabled = n === 0;
      });
      cards.forEach((c) => (c.hidden = true));
      matching.slice(0, limit).forEach((c) => (c.hidden = false));
      moreBtn.hidden = matching.length <= limit;
      countEl.textContent = `${Math.min(limit, matching.length)} ${ofWord} ${matching.length}`;
    };

    filters.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!chip) return;
      const row = chip.parentElement!;
      row.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      if ('format' in chip.dataset) format = chip.dataset.format ?? '';
      if ('client' in chip.dataset) client = chip.dataset.client ?? '';
      limit = initial;
      render();
    });

    moreBtn.addEventListener('click', () => {
      limit += initial;
      render();
    });

    const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]')!;
    const frame = dialog.querySelector<HTMLElement>('[data-frame]')!;

    grid.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLAnchorElement>('.video-card');
      if (!card || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      frame.className = 'dialog-frame ' + (card.dataset.format === 'v' ? 'is-vertical' : 'is-horizontal');
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${card.dataset.id}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = card.dataset.title ?? '';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      dialog.showModal();
    });

    const closeDialog = () => dialog.close();
    dialog.addEventListener('close', () => frame.replaceChildren());
    dialog.querySelector('[data-close]')!.addEventListener('click', closeDialog);
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });

    render();
  }
</script>

<script>
  const root = document.documentElement;
  const themeBtns = document.querySelectorAll<HTMLButtonElement>('[data-theme-set]');
  const syncThemeBtns = () =>
    themeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === root.dataset.theme)));
  themeBtns.forEach((b) =>
    b.addEventListener('click', () => {
      root.dataset.theme = b.dataset.themeSet;
      try {
        localStorage.setItem('theme', b.dataset.themeSet!);
      } catch {}
      syncThemeBtns();
    })
  );
  new MutationObserver(syncThemeBtns).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  syncThemeBtns();
</script>
